<mxfile host="app.diagrams.net" version="32.6.10" type="device"><diagram id="pi" name="大型项目宏观工作流"><mxGraphModel dx="2520" dy="1690" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2520" pageHeight="1690" math="0" shadow="0" background="#FFFFFF" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Codex × Pi-Durateam｜大型项目协作流程" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=38;align=center;verticalAlign=middle;spacing=12;align=left;spacing=0;fontColor=#182B43;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="35" width="1830" height="60" as="geometry" /></mxCell><mxCell id="subtitle" value="主会话做规划与必要干预；Worker 自主编码、自测；以简洁证据完成交付闭环。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;align=left;spacing=0;fontColor=#61728A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="1810" height="38" as="geometry" /></mxCell><mxCell id="badge" value="Pi-Durateam 0.7.12 / 专属配置" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#147E73;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1900" y="48" width="560" height="58" as="geometry" /></mxCell><mxCell id="phase1" value="01  接任务：先判断是否值得委派" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=25;align=center;verticalAlign=middle;spacing=12;align=left;spacing=0;fontColor=#147E73;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="1100" height="38" as="geometry" /></mxCell><mxCell id="goal" value="&lt;b&gt;用户提出项目目标&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px;color:#526175&quot;&gt;范围、约束、验收标准&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#BCD0E6;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="235" width="245" height="110" as="geometry" /></mxCell><mxCell id="skill" value="&lt;b&gt;Codex 加载调度 Skill&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;复用经验与派工判断&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;Skill 不是后台运行服务&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#BCD0E6;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="345" y="235" width="280" height="110" as="geometry" /></mxCell><mxCell id="choose" value="&lt;b&gt;本轮如何执行？&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;工作量 × 耦合 × 上下文&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6E8;strokeColor=#D8AE68;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="665" y="225" width="260" height="130" as="geometry" /></mxCell><mxCell id="contract" value="&lt;b&gt;先定共同契约与责任&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;接口 / 状态不变量 / 验收&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;按模块与依赖拆分，安排工作区&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#BCD0E6;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="965" y="235" width="350" height="110" as="geometry" /></mxCell><mxCell id="capacity" value="&lt;b&gt;主会话决定派几位 Worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;N 按任务收益选择，不必派满&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;同模块优先评估原会话是否可复用&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#BCD0E6;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1355" y="235" width="405" height="110" as="geometry" /></mxCell><mxCell id="dispatch_marker" value="↓  按计划进入 02 执行与反馈" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=19;align=center;verticalAlign=middle;spacing=12;align=left;spacing=0;fontColor=#2864AC;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1380" y="377" width="380" height="42" as="geometry" /></mxCell><mxCell id="local" value="&lt;b&gt;少量、高耦合：主会话局部处理&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#526175&quot;&gt;完成后同样进入 03 验收&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#CCD5DF;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="650" y="385" width="440" height="72" as="geometry" /></mxCell><mxCell id="plan_goal" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="goal" target="skill" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="plan_skill" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="skill" target="choose" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="plan_choose" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="choose" target="contract" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="plan_contract" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="contract" target="capacity" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="local_branch" value="直接处理" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A66614;strokeWidth=2.2;fontColor=#A66614;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="choose" target="local" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="phase2" value="02  自主执行与反馈" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=25;align=center;verticalAlign=middle;spacing=12;align=left;spacing=0;fontColor=#147E73;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="495" width="520" height="38" as="geometry" /></mxCell><mxCell id="codex_lane" value="CODEX 主会话" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=12;align=left;spacing=0;fontColor=#2864AC;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="470" height="35" as="geometry" /></mxCell><mxCell id="mcp_lane" value="MCP 调度台" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=12;align=left;spacing=0;fontColor=#147E73;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="550" width="180" height="35" as="geometry" /></mxCell><mxCell id="dispatch" value="&lt;b&gt;接收计划、启动并登记任务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;返回任务 / 会话标识&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;排队与并发由 MCP 管理&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#147E73;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="590" y="605" width="400" height="110" as="geometry" /></mxCell><mxCell id="watch" value="&lt;b&gt;等待 / 查看进展&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;非阻塞派发后可先做独立工作&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;到检查点再等待，不逐条盯工具&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#BCD0E6;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="605" width="470" height="110" as="geometry" /></mxCell><mxCell id="workers" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F8F4;strokeColor=#9CBFA9;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;swimlane;startSize=0;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1050" y="550" width="710" height="420" as="geometry" /></mxCell><mxCell id="team_header" value="&lt;b&gt;Worker 团队｜角色与人数只是示例&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;各自工作区 / 明确文件责任 / 较高实现自由度&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="workers"><mxGeometry x="20" y="15" width="670" height="65" as="geometry" /></mxCell><mxCell id="worker_a" value="&lt;b&gt;Worker A｜数据与核心逻辑&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#526175&quot;&gt;自己调查、实现、运行测试与返修&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B5D1BF;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="workers"><mxGeometry x="25" y="100" width="660" height="80" as="geometry" /></mxCell><mxCell id="worker_b" value="&lt;b&gt;Worker B｜接口与外部集成&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#526175&quot;&gt;按共同契约交付，不与其他 Worker 抢写&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B5D1BF;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="workers"><mxGeometry x="25" y="205" width="660" height="80" as="geometry" /></mxCell><mxCell id="worker_n" value="&lt;b&gt;Worker …｜其他模块 / 独立验证&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#526175&quot;&gt;只有任务确实需要时才增加角色&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B5D1BF;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="workers"><mxGeometry x="25" y="310" width="660" height="80" as="geometry" /></mxCell><mxCell id="events" value="&lt;b&gt;整理进展、问题和结果&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;进展 / 扩展提问 / 完成或失败&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;返回简洁状态、产物与测试证据&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#147E73;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="590" y="805" width="400" height="145" as="geometry" /></mxCell><mxCell id="decide" value="&lt;b&gt;Codex 根据摘要做判断&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;正常：继续等待；卡点：给思路&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;可交付：进入 03 验收；不默认通读源码&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6E8;strokeColor=#D8AE68;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="805" width="470" height="145" as="geometry" /></mxCell><mxCell id="feedback" value="&lt;b&gt;提供最小必要反馈&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;运行中纠偏 / 真实问题答复&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;已结束任务：原会话返修或增量&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6E8;strokeColor=#D8AE68;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="470" height="110" as="geometry" /></mxCell><mxCell id="control" value="&lt;b&gt;通过 MCP 交回对应会话&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;纠偏 steer · 真实提问 answer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;结束后续接 follow_up&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#147E73;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="590" y="1010" width="400" height="110" as="geometry" /></mxCell><mxCell id="resume" value="&lt;b&gt;原 Worker 继续推进并自测&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#526175&quot;&gt;保留模块知识与失败历史；独立方向才考虑新建 / fork&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F8F4;strokeColor=#9CBFA9;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1050" y="1010" width="710" height="110" as="geometry" /></mxCell><mxCell id="dispatch_to_workers" value="分发任务" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="dispatch" target="workers" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="workers_to_events" value="状态 / 问题 / 结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#15806D;strokeWidth=2.2;fontColor=#15806D;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;dashed=1;dashPattern=7 5;" edge="1" source="workers" target="events" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="watch_to_dispatch" value="等待" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="watch" target="dispatch" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dispatch_to_events" value="状态变化" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="dispatch" target="events" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="events_to_decide" value="反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#15806D;strokeWidth=2.2;fontColor=#15806D;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;dashed=1;dashPattern=7 5;" edge="1" source="events" target="decide" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="continue_wait" value="正常 / 暂无变化" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="decide" target="watch" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="need_help" value="需要介入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A66614;strokeWidth=2.2;fontColor=#A66614;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="decide" target="feedback" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="feedback_to_control" value="定向反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A66614;strokeWidth=2.2;fontColor=#A66614;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="feedback" target="control" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control_to_resume" value="继续原任务" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="control" target="resume" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="resume_to_workers" value="自主继续" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#15806D;strokeWidth=2.2;fontColor=#15806D;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="resume" target="workers" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="phase3" value="03  集成验收与交付" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=25;align=center;verticalAlign=middle;spacing=12;align=left;spacing=0;fontColor=#147E73;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1165" width="480" height="38" as="geometry" /></mxCell><mxCell id="acceptance_note" value="看产物、有效测试和整体行为，不只看模型返回成功" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=19;align=center;verticalAlign=middle;spacing=12;align=left;spacing=0;fontColor=#62738A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1050" y="1170" width="710" height="30" as="geometry" /></mxCell><mxCell id="integration" value="&lt;b&gt;集成产物并运行组合检查&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;检查实际文件、有效测试与退出码&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;跨模块失败仍交回责任会话&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#BCD0E6;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="1230" width="470" height="110" as="geometry" /></mxCell><mxCell id="accepted" value="&lt;b&gt;达到约定验收？&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#526175&quot;&gt;产物 / 测试 / 集成均可验证&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6E8;strokeColor=#D8AE68;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="615" y="1210" width="350" height="150" as="geometry" /></mxCell><mxCell id="delivery" value="&lt;b&gt;交付可验证成果&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;结果、日志、限制与剩余事项&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6EE;strokeColor=#8FB89C;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1050" y="1230" width="320" height="110" as="geometry" /></mxCell><mxCell id="retain" value="&lt;b&gt;保留有用上下文&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;交接说明 / 任务记录&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;不再需要的资源再清理&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6EE;strokeColor=#8FB89C;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1420" y="1230" width="340" height="110" as="geometry" /></mxCell><mxCell id="integration_to_acceptance" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="integration" target="accepted" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="acceptance_fail" value="未通过：定向返修" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A66614;strokeWidth=2.2;fontColor=#A66614;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="accepted" target="control" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="acceptance_pass" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#15806D;strokeWidth=2.2;fontColor=#15806D;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="accepted" target="delivery" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="delivery_to_retain" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="delivery" target="retain" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="phase4" value="04  新任务到来：重新评估，避免“来一个任务就新开一个 Agent”" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=25;align=center;verticalAlign=middle;spacing=12;align=left;spacing=0;fontColor=#147E73;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1410" width="1700" height="38" as="geometry" /></mxCell><mxCell id="increment" value="&lt;b&gt;新需求 / 下一阶段 / 收尾&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;重新回到派工判断&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#BCD0E6;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="1475" width="470" height="100" as="geometry" /></mxCell><mxCell id="reuse_check" value="&lt;b&gt;原上下文与工作区还适用吗？&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;看模块关联、依赖、当前状态&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6E8;strokeColor=#D8AE68;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="590" y="1475" width="400" height="100" as="geometry" /></mxCell><mxCell id="reuse_choice" value="&lt;b&gt;选择本轮最合适的执行方式&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;相关模块 → 原会话续接；独立工作 → 新建 / fork&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;少量强耦合修改 → 主会话处理；不按项目阶段一刀切&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#BCD0E6;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1050" y="1475" width="710" height="100" as="geometry" /></mxCell><mxCell id="increment_to_check" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="increment" target="reuse_check" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="check_to_choice" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2864AC;strokeWidth=2.2;fontColor=#2864AC;fontFamily=PingFang SC;fontSize=17;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;jettySize=auto;" edge="1" source="reuse_check" target="reuse_choice" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="wake_panel" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6F8FD;strokeColor=#C2CCE2;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1840" y="165" width="620" height="925" as="geometry" /></mxCell><mxCell id="wake_title" value="&lt;b&gt;反馈怎样让 Codex 继续？&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=27;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="wake_panel"><mxGeometry x="25" y="20" width="570" height="55" as="geometry" /></mxCell><mxCell id="wake_0" value="&lt;b&gt;1  主会话先调用等待 / 查看&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;任务已在后台运行；主会话按需要观察。&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DBE8;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="wake_panel"><mxGeometry x="25" y="100" width="570" height="110" as="geometry" /></mxCell><mxCell id="wake_1" value="&lt;b&gt;2  Worker 更新 MCP 内的状态&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;出现进展、真实问题或结束，等待条件满足。&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DBE8;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="wake_panel"><mxGeometry x="25" y="233" width="570" height="110" as="geometry" /></mxCell><mxCell id="wake_2" value="&lt;b&gt;3  正在等待的 MCP 调用返回&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;返回的是工具结果，不是 Worker 直接对 LLM 发消息。&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DBE8;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="wake_panel"><mxGeometry x="25" y="366" width="570" height="110" as="geometry" /></mxCell><mxCell id="wake_3" value="&lt;b&gt;4  宿主把结果交回当前 Codex 回合&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;主会话继续判断，选择等待、反馈或验收。&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DBE8;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="wake_panel"><mxGeometry x="25" y="499" width="570" height="110" as="geometry" /></mxCell><mxCell id="wake_boundary" value="&lt;b&gt;没有等待调用 / 主回合已结束时&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#526175&quot;&gt;后台状态变化本身不保证唤醒模型。&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#526175&quot;&gt;需要宿主额外的调度机制，或之后再查看。&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#DBB77E;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="wake_panel"><mxGeometry x="25" y="650" width="570" height="130" as="geometry" /></mxCell><mxCell id="wake_foot" value="&lt;b&gt;当前实现的边界&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;Pi 的 progress 通知可用于进度展示或保持连接；&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#526175&quot;&gt;不能据此认定它能启动一个新的模型推理回合。&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="wake_panel"><mxGeometry x="25" y="805" width="570" height="95" as="geometry" /></mxCell><mxCell id="version_note" value="&lt;b&gt;Pi-Durateam｜本机落地方式&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#526175&quot;&gt;模型：DeepSeek V4.1 Flash / max（本机专属默认）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#526175&quot;&gt;容量：每 MCP 进程上限 5；按依赖和冲突选择 N&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#526175&quot;&gt;工作树：由主会话 / Skill 安排，Pi 使用传入 cwd&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#526175&quot;&gt;能力：按任务授予 Bash、AST、LSP、Skill 与 MCP&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#526175&quot;&gt;连续性：原会话 follow_up；durable 可选，handoff 交接&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#526175&quot;&gt;旧 owner 仍活跃时，不重复接管同一任务&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#147E73;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=26;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1840" y="1135" width="620" height="440" as="geometry" /></mxCell><mxCell id="legend" value="图例：蓝色＝主控与调度　绿色＝执行与交付　橙色＝判断与介入　虚线＝状态回流" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=19;align=center;verticalAlign=middle;spacing=12;align=left;spacing=0;fontColor=#62738A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1615" width="1720" height="35" as="geometry" /></mxCell><mxCell id="scope" value="依据当前 Skill 与本机实现绘制 · 人数/角色为示例 · 不假定宿主具备额外后台唤醒能力" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.6;fontColor=#182B43;fontFamily=PingFang SC;fontSize=18;align=center;verticalAlign=middle;spacing=12;align=left;spacing=0;fontColor=#7D8898;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1655" width="2350" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>